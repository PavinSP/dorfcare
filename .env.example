# Copy to .env.local and fill in. Leave empty to use the built-in offline companion.
VITE_ELEVENLABS_AGENT_ID=
# Set to true only after enabling "Language" + "First message" overrides in the agent's Security tab.
VITE_ELEVENLABS_ALLOW_OVERRIDES=false

# --- Landline check-in calls (scripts/elevenlabs-call.mjs, docs/elevenlabs-phone-checkin.md) ---
# Server-side only: NEVER prefix these with VITE_ (that would ship them to the browser).
# ElevenLabs API key (Settings → API keys). Keep it in .env.local, never commit it.
ELEVENLABS_API_KEY=
# The separate "Clara – daily check-in call" agent (not the nurse companion agent above).
ELEVENLABS_CHECKIN_AGENT_ID=
# ID of the Twilio number imported under ElevenAgents → Phone Numbers (not the phone number itself).
ELEVENLABS_PHONE_NUMBER_ID=
# Optional shared secret: the dev server's POST /api/phone-events then requires header x-dorfconnect-secret.
# Put the same value as a Secret header in the agent's webhook tools. Restart `npm run dev` after changing it.
PHONE_WEBHOOK_SECRET=
